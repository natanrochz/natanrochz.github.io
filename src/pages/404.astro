---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Página não encontrada">
  <main class="wrapper flex min-h-dvh flex-col justify-center py-20">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Página não encontrada</h1>
    <p class="mt-3 text-muted">Essa página não existe ou foi removida.</p>
    <p class="mt-1 text-sm text-subtle" lang="en">This page doesn't exist or has been removed.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Voltar para o início</a>
      <a href="/en/" class="btn-secondary" lang="en">Back to home</a>
    </div>
  </main>
</Layout>
