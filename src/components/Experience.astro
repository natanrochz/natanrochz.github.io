---
import Section from './Section.astro';
import { experience } from '../data/experience';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import GraduationCapIcon from '../icons/graduation-cap.svg';
import BriefcaseIcon from '../icons/briefcase.svg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="experience" number="02" title={t('experience.title')}>
  <ol class="relative ml-4 border-l border-line">
    {
      experience.map((item) => (
        <li class="reveal relative pb-10 pl-8 last:pb-0">
          <span class="absolute top-0 -left-4 flex size-8 items-center justify-center rounded-full border border-line bg-surface text-accent">
            {item.type === 'education' ? <GraduationCapIcon class="size-4" /> : <BriefcaseIcon class="size-4" />}
          </span>

          <p class="font-mono text-xs text-subtle">{item.period[lang]}</p>
          <h3 class="mt-1.5 text-lg font-medium">{item.title[lang]}</h3>
          <p class="text-sm text-accent">{item.place}</p>
          {item.description && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{item.description[lang]}</p>}
        </li>
      ))
    }
  </ol>
</Section>
