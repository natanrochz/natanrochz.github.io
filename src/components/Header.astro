---
import { profile } from '../data/profile';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SunIcon from '../icons/sun.svg';
import MoonIcon from '../icons/moon.svg';
import MenuIcon from '../icons/menu.svg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: '#about', label: t('nav.about') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-4 focus:rounded-lg focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
  >
    {t('nav.skip')}
  </a>

  <div class="wrapper flex h-16 items-center justify-between gap-4">
    <a href="#top" class="font-mono text-sm font-semibold">
      <span class="mr-1.5 text-accent">&gt;</span>{profile.shortName}
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="rounded-md px-3 py-2 text-muted transition-colors hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={lang === 'pt' ? '/en/' : '/'}
        class="icon-btn w-auto px-2.5 font-mono text-xs font-semibold"
        title={t('nav.lang')}
      >
        {lang === 'pt' ? 'EN' : 'PT'}
      </a>

      <button id="theme-btn" type="button" class="icon-btn" aria-label={t('nav.theme')}>
        <SunIcon class="size-[18px] light:hidden" />
        <MoonIcon class="hidden size-[18px] light:block" />
      </button>

      <button
        id="menu-btn"
        type="button"
        class="icon-btn md:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <MenuIcon class="size-5" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-line md:hidden">
    <ul class="wrapper flex flex-col py-2">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="block px-2 py-3 text-muted hover:text-fg">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const themeBtn = document.getElementById('theme-btn');
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  themeBtn?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  });

  function toggleMenu(open: boolean) {
    menuBtn?.setAttribute('aria-expanded', String(open));
    mobileMenu?.classList.toggle('hidden', !open);
  }

  menuBtn?.addEventListener('click', () => {
    toggleMenu(menuBtn.getAttribute('aria-expanded') === 'false');
  });

  // fecha o menu quando clica em algum link
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });
</script>
